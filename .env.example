# ─── MongoDB ────────────────────────────────────────────────
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=your_password_here
MONGO_DB=
MONGO_PORT=

# ─── App port ───────────────────────────────────────────────
APP_PORT=

# ─── Default Admin (auto-created on first startup) ──────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=
